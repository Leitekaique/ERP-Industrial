# ================================
# 🌍 Ambiente e Aplicação
# ================================
NODE_ENV=development
PORT=3000

# ================================
# 🗃️ Banco de Dados
# ================================
DATABASE_URL=postgresql://postgres:postgres@db:5432/erp?schema=public

# ================================
# 🧩 Prisma
# ================================
PRISMA_CLI_BINARY_TARGETS=debian-openssl-3.0.x,windows,linux-musl
PRISMA_GENERATE_SKIP_DOWNLOAD=true
PRISMA_CLI_QUERY_ENGINE_TYPE=library
PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
PRISMA_LOG_LEVEL=info
PRISMA_HIDE_UPDATE_MESSAGE=true

# ================================
# ⚙️ Configurações do ERP
# ================================
DEFAULT_TENANT_ID=T-001
DEFAULT_COMPANY_ID=C-001

# ================================
# 🔐 Autenticação
# ================================
JWT_SECRET=troque-por-uma-chave-segura-em-producao
JWT_EXPIRES_IN=24h

# ================================
# 📡 SEFAZ / NF-e
# ================================
# Modos disponíveis:
#   simulator   → sem certificado, resposta simulada (DEV/testes)
#   homologacao → SEFAZ homologação, certificado obrigatório
#   producao    → SEFAZ produção, certificado obrigatório
SEFAZ_ENV=simulator
SEFAZ_UF=35

# Certificado A1 — necessário apenas em homologacao/producao
# CERT_PATH=/caminho/para/certificado.pfx
CERT_PASSWORD=

# ================================
# 📧 E-mail / SMTP
# ================================
# MAIL_ENABLED=false → nenhum e-mail é enviado (dev/testes)
# MAIL_ENABLED=true  → envio real via SMTP
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-gmail
SMTP_FROM=Nome Empresa <seu-email@gmail.com>

# E-mail do escritório principal (NF-e, eventos, cancelamentos)
OFFICE_EMAIL=escritorio@empresa.com.br
# E-mail do escritório de contabilidade (faturas, cobranças, confirmações de pagamento)
# Se não configurado, usa OFFICE_EMAIL como fallback
BILLING_EMAIL=contabilidade@escritorio.com.br

# ================================
# 📊 IBPT — Tributos Aproximados (Lei 12.741/2012)
# ================================
# Alíquotas atualizadas automaticamente via ibpt.valraw.com.br (sem autenticação).
# Opcional: sobrescrever NCM e UF padrão
# IBPT_NCM=5903    # NCM do produto (padrão: 5903 — tecidos impregnados)
# IBPT_UF=SP       # UF para alíquota estadual (padrão: SP)

# ================================
# 🧠 Frontend
# ================================
VITE_API_URL=http://localhost:3000

# ================================
# 📝 Logs em arquivo
# ================================
# Um arquivo JSON por dia (api-AAAA-MM-DD.log), compactado e guardado por 30 dias.
# No container, ./logs = /usr/src/app/logs (volume → C:\ERP-Deploy\logs no cliente).
# Corpo de requisição/resposta NUNCA é registrado.
LOG_DIR=./logs
# Nível mínimo: error | warn | info | debug
LOG_LEVEL=info

# ================================
# 🚨 Sentry (monitoramento de erros) — OPCIONAL
# ================================
# Sem SENTRY_DSN o Sentry fica desligado e nada muda.
# O DSN vem do painel do Sentry: Settings → Projects → (projeto) → Client Keys (DSN).
# environment = SEFAZ_ENV (ou NODE_ENV); release = versão do package.json.
# Coloque o DSN real só no .env.prod do cliente, nunca no repositório.
# SENTRY_DSN=https://<chave>@o000000.ingest.us.sentry.io/0000000
