# ── Variáveis de ambiente (contêm senhas e segredos) ─────────────────────────
.env
.env.dev
.env.prod
.env.local
.env.*.local

# ── Certificado digital ───────────────────────────────────────────────────────
*.pfx
*.p12
*.cer
*.pem
certs/

# ── Dependências ──────────────────────────────────────────────────────────────
node_modules/
web/node_modules/

# ── Build / compilação ────────────────────────────────────────────────────────
dist/
web/dist/
*.tsbuildinfo
tsconfig.build.tsbuildinfo

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── Backups e uploads ─────────────────────────────────────────────────────────
backups/
uploads/
*.sql.gz

# ── XML e PDF gerados ─────────────────────────────────────────────────────────
xml/
*.xml
*.pdf

# ── Claude Code (sessões internas) ───────────────────────────────────────────
.claude/

# ── Temporários / sistema ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
*.tgz

# ── Prisma (gerado automaticamente, não versionado) ───────────────────────────
# prisma/migrations são versionados — apenas o client gerado é ignorado
node_modules/.prisma/

# ── Scripts temporários de debug / patch ──────────────────────────────────────
patch-*.js

# ── Arquivos de deploy e produção (contêm caminhos/senhas do servidor) ────────
copiar-deploy.ps1
docker-compose.prod.yml
# exceção: o compose do cliente do pipeline novo não tem segredos (ficam no .env.prod)
!deploy/cliente/docker-compose.prod.yml
erp-api.tar
scripts/1_preparar_deploy.ps1
scripts/2_instalar_cliente.ps1
scripts/agendar-backup.ps1
scripts/backup-diario.ps1
scripts/backup-semanal-gdrive.ps1

# ── SQL operacional (dados reais da empresa) ──────────────────────────────────
deploy-db.sql
limpar-nfe-hoje.sql

# ── Logs de ferramentas externas ──────────────────────────────────────────────
*robocopy-log.txt

# Dumps do banco (dados reais de clientes) — nunca versionar
backup_banco*.sql
# Qualquer .sql ou diagnóstico solto na RAIZ (ex.: backup trazido do cliente).
# Scripts versionados ficam em scripts/, docs/ e prisma/, que não são afetados.
/*.sql
/diagnostico*.txt

# Documentos internos com dados reais (clientes, preços, NFs) — ficam só na máquina
versionamento.md
docs/prints/
docs/*.png
docs/*.xlsx
docs/restaurar_*
docs/corrigir_cnpj_*
docs/excluir_nf_*

# Pacotes .tar do plano B (centenas de MB)
deploy/pacotes/
